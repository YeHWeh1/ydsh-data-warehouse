# ============================================================
# 第 4 周 环境变量模板
# 用法：复制为 .env 后填写真实值；.env 已被 .gitignore 排除，切勿提交
#   cp .env.example .env
# ============================================================

# ---------- 大模型 API 密钥（留空则 NL2SQL 走规则引擎兜底）----------
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=deepseek

# ---------- ClickHouse 应用账号（不要用 default 空口令）----------
CLICKHOUSE_USER=ydsh
CLICKHOUSE_PASSWORD=

# ---------- Superset ----------
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=
SUPERSET_ADMIN_EMAIL=admin@example.com
